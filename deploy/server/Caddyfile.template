# Caddy 反向代理模板（install.sh 渲染为 /etc/caddy/Caddyfile）。
#
# 占位符（下方用双花括号包裹；注释里不要写出完整占位符，否则也会被替换）：
#   SITE_HOST      对外地址：域名（backup.example.com）或公网 IP（120.79.245.99）
#   TLS_BLOCK      域名：留空（Caddy 自动申请普通证书）
#                  IP：使用 Let's Encrypt 短期 IP 证书（约 6 天，自动续期）
#   GLOBAL_EXTRA   IP：`default_sni <IP>`。云主机的公网 IP 经 NAT 映射，
#                  浏览器访问 IP 时不发送 SNI，没有它 TLS 握手会失败。
{
	{{GLOBAL_EXTRA}}
	servers {
		trusted_proxies static private_ranges
	}
}

https://{{SITE_HOST}} {
	{{TLS_BLOCK}}
	encode zstd gzip

	# 客户端下载（add-client-releases D4）：Caddy 直接读取 /opt/backup/downloads，
	# 不经过应用容器。handle_path 会去掉 /downloads 前缀，root 下是
	# latest.json、latest.json.sig 与 <版本>/安装包。
	# - 清单与签名必须每次回源：no-cache；
	# - 版本目录内文件名含版本号、内容不可变：长期缓存；
	# - 安装包强制下载（浏览器不内联打开）。
	# 应用的 CSP 等安全头只作用于反向代理的响应；下载由 Caddy 直接提供，
	# 不经过应用，因此不会被这些头影响。
	handle_path /downloads/* {
		root * /opt/backup/downloads
		@manifest path /latest.json /latest.json.sig
		header @manifest Cache-Control "no-cache"
		@versioned path_regexp ^/[0-9]+\.[0-9]+\.[0-9]+/.*$
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		@installer path *.exe *.dmg
		header @installer Content-Disposition "attachment"
		file_server
	}

	reverse_proxy 127.0.0.1:8080
}

http://{{SITE_HOST}} {
	redir https://{{SITE_HOST}}{uri} permanent
}
