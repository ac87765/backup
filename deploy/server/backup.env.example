# 生产应用配置模板（install.sh 首次安装时复制为 /opt/backup/backup.env，权限 600）。
# install.sh 会自动生成 BACKUP_AUTH_PEPPER 与 BACKUP_AUTH_FAKE_SALT_KEY；
# 标记为【必填】的项需要你自己填写。完整说明见 deploy/oss/README.md 第 5 节。
# 不要把填好的文件提交到仓库、发到聊天工具或放进镜像。

# ---------------------------------------------------------------------------
# 基础（一般不用改）
# ---------------------------------------------------------------------------
BACKUP_BIND_ADDR=0.0.0.0:8080
BACKUP_METRICS_ADDR=0.0.0.0:9091
BACKUP_STATIC_DIR=/app/web/dist
BACKUP_DATABASE_MAX_CONNECTIONS=10
BACKUP_JOBS_ENABLED=true
# 宿主机 Caddy 经 docker 网关 172.30.0.1 访问 server（见 compose.yml 的固定网段）。
BACKUP_TRUSTED_PROXIES=172.30.0.1/32

# 【必填】用户在浏览器里访问的地址（邮件链接也用它），例如 https://backup.example.com
# 或 https://120.79.245.99。install.sh 会按 SITE_HOST 自动填写。
BACKUP_PUBLIC_APP_URL=https://SITE_HOST

# ---------------------------------------------------------------------------
# 阿里云 OSS（【必填】，bucket 配置与 RAM 最小权限见 deploy/oss/README.md）
# ---------------------------------------------------------------------------
BACKUP_STORAGE_KIND=oss
BACKUP_STORAGE_BUCKET=your-bucket
BACKUP_STORAGE_REGION=oss-cn-shenzhen
# 服务器与 bucket 同地域时用内网 endpoint（不收流量费）；否则两项都填公网 endpoint。
BACKUP_STORAGE_INTERNAL_ENDPOINT=https://oss-cn-shenzhen-internal.aliyuncs.com
BACKUP_STORAGE_PUBLIC_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
BACKUP_STORAGE_ACCESS_KEY_ID=REPLACE_ME
BACKUP_STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
BACKUP_STORAGE_ALLOW_HTTP=false

# ---------------------------------------------------------------------------
# 认证密钥（install.sh 自动生成；不要复用、不要泄露；轮换方法见 deploy/oss/README.md）
# ---------------------------------------------------------------------------
BACKUP_AUTH_PEPPER_VERSION=1
BACKUP_AUTH_PEPPER=GENERATED_BY_INSTALL
BACKUP_AUTH_FAKE_SALT_KEY=GENERATED_BY_INSTALL

# ---------------------------------------------------------------------------
# 邮件
# ---------------------------------------------------------------------------
# 未配置 SMTP 时用 file 模式：邮件写入容器内目录，用 get-link.sh 取验证链接。
BACKUP_MAIL_MODE=file
BACKUP_MAIL_DIR=/var/lib/backup/mail
# 配置 SMTP 后改为下面这一组（以 QQ 邮箱为例；PASSWORD 是邮箱的 SMTP 授权码，不是登录密码），
# 并删除上面两行 file 模式配置：
# BACKUP_MAIL_MODE=smtp
# BACKUP_SMTP_HOST=smtp.qq.com
# BACKUP_SMTP_PORT=465
# BACKUP_SMTP_TLS=implicit
# BACKUP_SMTP_FROM=you@qq.com
# BACKUP_SMTP_USERNAME=you@qq.com
# BACKUP_SMTP_PASSWORD=REPLACE_ME
# BACKUP_SMTP_ALLOW_INSECURE=false

# ---------------------------------------------------------------------------
# 限流与额度
# ---------------------------------------------------------------------------
BACKUP_AUTH_RATE_LIMIT_PER_MINUTE=60
# 文件夹备份时每个小文件约 4 次写请求；1200 可让上千个小文件几分钟内传完。
BACKUP_USER_WRITE_RATE_LIMIT_PER_MINUTE=1200
# 每个 IP 每小时允许成功注册的账号数（防批量注册）。
BACKUP_REGISTRATION_RATE_LIMIT_PER_HOUR=5
# 新用户默认额度与单用户额度上限（字节）；管理后台“设置”里的默认额度优先。
# BACKUP_DEFAULT_QUOTA_BYTES=10737418240
# BACKUP_MAX_QUOTA_BYTES=10995116277760
