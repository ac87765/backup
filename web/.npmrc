# openapi-typescript 7.x 的 peerDependency 仍声明 typescript ^5，
# 但本仓库使用 TypeScript 6 且生成物是独立 .d.ts；该工具本身不调用 tsc API。
# 用 legacy-peer-deps 让本地安装与 CI 的 `npm ci` 行为一致。
# 移除条件：openapi-typescript 正式支持 TypeScript 6（peerDependencies 允许 ^6）
# 后删除本设置，并同时移除 package.json 中为 legacy 模式手工补充的 peer 依赖
# （@testing-library/dom）。
legacy-peer-deps=true
