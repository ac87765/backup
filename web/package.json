{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ../crates/crypto-wasm --target web --release --no-opt --out-dir ../../web/src/generated/crypto-wasm --out-name crypto_wasm",
    "ensure:wasm": "node scripts/ensure-wasm.mjs",
    "predev": "npm run ensure:wasm",
    "build": "tsc -b && vite build",
    "prebuild": "npm run ensure:wasm",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "generate:api": "node scripts/generate-api.mjs",
    "test": "vitest run",
    "pretest": "npm run ensure:wasm",
    "test:watch": "vitest",
    "e2e:serve": "npm run build && node e2e/serve.mjs",
    "test:e2e": "playwright test",
    "test:e2e:container": "playwright test --config playwright.container.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "client-zip": "^2.5.1",
    "comlink": "^4.4.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
