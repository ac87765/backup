  "query": "\n        SELECT id, admin_id, action, target_user_id, details, ip, created_at\n        FROM admin_audit_log\n        WHERE ($1::uuid IS NULL OR target_user_id = $1)\n          AND ($2::bigint IS NULL OR id < $2)\n        ORDER BY id DESC\n        LIMIT $3\n        ",
