{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT fv.content_id, fv.encrypted_meta, c.ciphertext_size, c.chunk_count\n        FROM file_versions fv\n        JOIN contents c\n            ON c.id = fv.content_id AND c.user_id = fv.user_id\n        WHERE fv.id = $1\n          AND fv.node_id = $2\n          AND fv.user_id = $3\n        ",
