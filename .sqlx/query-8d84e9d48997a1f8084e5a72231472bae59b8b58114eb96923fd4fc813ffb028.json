{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, created_at, last_seen_at, ip, user_agent,\n               (revoked_at IS NOT NULL) AS \"revoked!\"\n        FROM sessions\n        WHERE user_id = $1\n        ORDER BY created_at DESC, id DESC\n        LIMIT 20\n        ",
