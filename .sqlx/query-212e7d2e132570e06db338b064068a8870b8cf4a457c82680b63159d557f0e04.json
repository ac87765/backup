{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, created_at, last_seen_at, expires_at, ip, user_agent\n        FROM sessions\n        WHERE user_id = $1\n          AND revoked_at IS NULL\n          AND expires_at > now()\n          AND last_seen_at > now() - make_interval(days => $2)\n        ORDER BY last_seen_at DESC\n        ",
