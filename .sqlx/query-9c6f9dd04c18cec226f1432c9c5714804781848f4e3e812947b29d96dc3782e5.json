{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT s.id, s.user_id, s.created_at, u.status, u.is_admin\n            FROM sessions s\n            JOIN users u ON u.id = s.user_id\n            WHERE s.token_hash = $1\n              AND s.revoked_at IS NULL\n              AND s.expires_at > now()\n              AND s.last_seen_at > now() - make_interval(days => $2)\n            ",
